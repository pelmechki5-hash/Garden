# Скопируй этот файл в .env.local и вставь настройки своего Supabase.
# Локальный .env.local игнорируется git и не попадёт в GitHub.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Необязательный ключ AI.
# GEMINI_API_KEY=YOUR_SECRET_KEY

# Email-напоминания за 3 дня до срока: бесплатный ключ с resend.com
# RESEND_API_KEY=YOUR_SECRET_KEY
# REMINDER_FROM_EMAIL=Долги <reminders@example.com>
